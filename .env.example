# Frontend
VITE_API_BASE_URL=http://localhost:3000

# API Gateway
GATEWAY_PORT=3000
JWT_ACCESS_SECRET=replace-with-local-secret
JWT_SERVICE_SECRET=replace-with-service-signing-secret
