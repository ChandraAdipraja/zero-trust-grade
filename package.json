{
  "name": "zero-trust-security",
  "version": "0.1.0",
  "private": true,
  "description": "Sistem Nilai - Zero Trust Security, tugas praktikum Keamanan Informasi",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,gateway,nilai,transkrip -c cyan,green,yellow,magenta \"npm:dev:web\" \"npm:dev:gateway\" \"npm:dev:nilai\" \"npm:dev:transkrip\"",
    "reset:seed": "node scripts/reset-seed-state.mjs",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:gateway": "npm run dev --workspace apps/gateway",
    "dev:nilai": "npm run dev --workspace apps/nilai-service",
    "dev:transkrip": "npm run dev --workspace apps/transkrip-service",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:web": "npm run typecheck --workspace apps/web",
    "typecheck:gateway": "npm run typecheck --workspace apps/gateway",
    "typecheck:nilai": "npm run typecheck --workspace apps/nilai-service",
    "typecheck:transkrip": "npm run typecheck --workspace apps/transkrip-service"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
